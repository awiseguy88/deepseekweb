# WiseAI VPS deployment environment. Copy to deploy/.env and fill; never commit it.
WISEAI_AUTH_REQUIRED=1
WISEAI_SESSION_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgres://wiseai:replace-db-password@postgres:5432/wiseai
POSTGRES_PASSWORD=replace-db-password
WISEAI_ADMIN_EMAIL=you@example.com
# Only used when the admin account does not exist yet.
WISEAI_ADMIN_PASSWORD=replace-with-a-strong-password
WISEAI_LANDING_PAGE=/app/wiseai-immersive.html
WISEAI_DOCUMENTS_DIR=/data/workspaces
WISEAI_TENANT_ROOT=/data/workspaces/tenants
WISEAI_WORKSPACE_ROOT=/data/workspace
WISEAI_RECOVER_MISSING_CWD=1
WISEAI_MAX_ACTIVE_SUBAGENTS=32
# Must match the Caddy site address, with a trailing slash on the URL.
DSH_WEB_PUBLIC_URL=https://YOURDOMAIN/
DSH_WEB_TRUSTED_HOST=YOURDOMAIN
WISEAI_DOMAIN=YOURDOMAIN
PORT=8080
# Optional billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
